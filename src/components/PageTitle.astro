---
// The title id is `_top` (Starlight's skip-link target); its constant is not
// exported from the package, so it is spelled here.
const PAGE_TITLE_ID = '_top';

const data = Astro.locals.starlightRoute.entry.data;
const day = typeof data.day === 'number' ? data.day : undefined;
const time = typeof data.time === 'string' ? data.time : undefined;
const daySlug = day ? `/days/day-${String(day).padStart(2, '0')}/` : undefined;
---

<h1 id={PAGE_TITLE_ID}>{data.title}</h1>
{
	day && (
		<a class="day-badge" href={daySlug} data-day={day}>
			Day {day}
			{time ? ` · ≈${time}` : ''}
			<span class="day-badge-done" aria-hidden="true" />
		</a>
	)
}

<style>
	@layer starlight.core {
		h1 {
			margin-top: 1rem;
			font-size: var(--sl-text-h1);
			line-height: var(--sl-line-height-headings);
			font-weight: 600;
			color: var(--sl-color-white);
		}
	}

	.day-badge {
		display: inline-flex;
		gap: 0.4rem;
		align-items: center;
		margin-top: -0.25rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		text-decoration: none;
	}

	.day-badge:hover {
		color: var(--sl-color-accent-high);
	}

	.day-badge.done {
		color: var(--sl-color-accent-high);
	}

	.day-badge-done::before {
		content: '';
	}

	.day-badge.done .day-badge-done::before {
		content: '✓ done';
	}
</style>
